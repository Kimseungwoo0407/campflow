# CampFlow 환경 변수 예시
# required 값을 빈 상태로 두었으므로 운영 비밀값을 직접 생성해야 합니다.

# 공통
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
APP_ORIGIN=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000
DATABASE_URL=
REDIS_URL=redis://127.0.0.1:6380

# 인증 (required: 각각 독립적인 32바이트 이상 랜덤 문자열)
JWT_ACCESS_SECRET=
REFRESH_TOKEN_PEPPER=
INVITE_TOKEN_PEPPER=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# 선택: 비공개 친구 계정 seed JSON. 실제 값은 저장소에 커밋하지 않습니다.
# [{"username":"이름","email":"name@campflow.local","nickname":"이름","password":"생일 4자리"}]
SEED_FRIEND_ACCOUNTS_JSON=
ALLOW_PRODUCTION_SEED=false

# 프런트에 노출 가능한 공개 값
VITE_APP_NAME=CampFlow
VITE_API_BASE_URL=http://localhost:4000/v1
VITE_SOCKET_URL=http://localhost:4000
VITE_KAKAO_MAP_JS_KEY=
VITE_GITHUB_PAGES_BASE=/
VITE_DEMO_MODE=true

# 저장소 (Phase 0에서는 MinIO 상태 확인에 사용)
STORAGE_DRIVER=minio
STORAGE_LOCAL_PATH=storage-data/uploads
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=campflow

# 외부 Provider (모두 optional)
DEMO_PROVIDER=true
KAKAO_REST_API_KEY=
TOUR_API_SERVICE_KEY=
NAVER_API_HUB_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# 홈 서버/터널 (운영에서만 required)
POSTGRES_DB=campflow
POSTGRES_USER=campflow
POSTGRES_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
TUNNEL_TOKEN=
